<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/apk/res-tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#202124">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Row: Blue Dot + City + Choose Area + Ellipsis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@android:drawable/presence_online"
                android:backgroundTint="#4285F4"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Raipur"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="160dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dot_separator"
                android:textColor="#9AA0A6"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvChooseArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_area"
                android:textColor="#8AB4F8"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#9AA0A6" />
        </LinearLayout>

        <!-- Weather Main Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <!-- Left: Icon and Temperature -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivWeatherIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    tools:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="42"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/celsius"
                    android:textColor="#9AA0A6"
                    android:textSize="14sp"
                    android:layout_gravity="top"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Middle: Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvPrecipitation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Precipitation: 0%"
                    android:textColor="#9AA0A6"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Humidity: 24%"
                    android:textColor="#9AA0A6"
                    android:textSize="10sp"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/tvWind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Wind: 8 km/h"
                    android:textColor="#9AA0A6"
                    android:textSize="10sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Right: Heading / Time / Condition -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDateTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Wednesday, 2:00 pm"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"
                    android:gravity="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvConditionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Partly sunny"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeeklyForecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="32dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDailyWeeklyForecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
