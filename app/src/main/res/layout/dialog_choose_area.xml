<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#202124"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/ivCloseDialog"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dialog_title_choose_area"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/ivCloseDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/app_name"
            app:tint="#9AA0A6" />
    </RelativeLayout>

    <!-- Professional Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <EditText
            android:id="@+id/etDialogSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_city_hint"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:textSize="16sp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnDialogSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@string/app_name"
            app:tint="#8AB4F8" />
    </LinearLayout>

    <!-- Scrollable Content to prevent wrapping issues on small screens or long lists -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recent Searches -->
            <TextView
                android:id="@+id/tvRecentSearchesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Recent Searches"
                android:textColor="#9AA0A6"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#3C4043" />

            <!-- Quick Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Quick Actions"
                android:textColor="#9AA0A6"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetHome"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/set_current_as_home"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_myplaces"
                app:iconTint="#8AB4F8"
                app:strokeColor="#3C4043" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsePreciseLocation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="@string/use_precise_location"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconTint="#8AB4F8"
                app:strokeColor="#3C4043" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#3C4043" />

            <!-- Popular Cities -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/popular_label"
                android:textColor="#9AA0A6"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raipur"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#303134"
                    app:chipIcon="@android:drawable/ic_menu_mylocation"
                    app:chipIconTint="#9AA0A6"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bhilai"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#303134"
                    app:chipIcon="@android:drawable/ic_menu_mylocation"
                    app:chipIconTint="#9AA0A6"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
